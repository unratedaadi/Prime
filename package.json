{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "agent:mac": "node agent/mac/bootstrap.mjs",
    "agent:mac:install": "node agent/mac/install.mjs",
    "wake:mac:build": "node macos/AstraWakeListener/build.mjs",
    "wake:mac:install": "node macos/AstraWakeListener/install.mjs",
    "window-manager:mac:build": "node macos/PrimeWindowManager/build.mjs",
    "build": "vite build",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --mac dir",
    "desktop:install": "npm run desktop:package && node desktop/install.mjs",
    "test": "node --test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.aadityjain.prime.control-center",
    "productName": "PRIME Control Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "agent/mac/dashboard-bridge.mjs",
      "agent/mac/policy.mjs",
      "package.json",
      "agent/mac/app-catalog.mjs"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
