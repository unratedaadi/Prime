# PRIME runs locally without an API key by default.
# Keep this unset to use the mock/local command path.
PRIME_AI_PROVIDER=
PRIME_AI_API_KEY=

# Optional future integrations. Do not add account credentials unless you have
# deliberately enabled that integration in PRIME's Permissions & safety screen.
PRIME_WEATHER_API_KEY=
PRIME_SPOTIFY_CLIENT_ID=
